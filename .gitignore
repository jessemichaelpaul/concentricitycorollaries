# Lean / lake build artifacts and downloaded dependencies (regenerated by
# `lake build` / `lake exe cache get`)
/.lake

# macOS noise
.DS_Store

# Claude Code local settings
.claude/

# Blueprint build outputs (regenerated by ./rebuild.sh)
/blueprint/web/
/blueprint/print/

# Auto-generated from Octonionic_RH_master.tex by
# scripts/extract_blueprint_content.py (run via ./rebuild.sh).
# The master file is the single source of truth; tracked copies would invite
# divergence.
/blueprint/src/masterdefs.tex
/blueprint/src/content.tex

# plasTeX auxiliary build artifact (regenerated every build)
/blueprint/src/web.paux
retired/

# Third-party source PDFs fetched into inbox/ for reading and transcription.
# These are other authors' works, several under personal-use-only terms that
# forbid re-distribution (Riehl's two books carry that note explicitly; see
# SOURCES/Riehl.md and SOURCES/Riehl-CTIC.md). Committing them to a repo
# destined for GitHub would redistribute them. The tracked citation record is
# SOURCES/*.md — our own transcriptions, with pinpoint page numbers and
# verification hashes — never the PDFs themselves.
inbox/*.pdf

# LaTeX build artifacts (regenerated by latexmk/pdflatex)
*.aux
*.log
*.toc
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.nav
*.snm
*.vrb
