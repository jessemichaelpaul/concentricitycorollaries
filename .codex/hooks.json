{
  "description": "Project-local provenance boundary for Codex; existing Concentricity guidance is preserved.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/provenance_project_lock.py\"",
            "statusMessage": "checking active provenance project and authoring phase"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c 'if (.tool_input.file_path // \"\" | test(\"Concentricity/.*\\\\.lean$\")) then {hookSpecificOutput:{hookEventName:\"PreToolUse\",additionalContext:\"CONTRACT CHECK (Lean edit): (1) Did Jesse name/point at THIS exact object? (2) Are you inventing a map/fibre/obstacle no one discussed? (3) Claiming built without a green lake? Post the CONTRACT CHECK line before proceeding.\"}} else empty end'"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/provenance_project_lock.py\"",
            "statusMessage": "enforcing provenance sandbox"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -Rs '{hookSpecificOutput:{hookEventName:\"SessionStart\",additionalContext:.}}' /Users/jessepaul/Desktop/concentricity/register/00-register.md"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/tools/claim_gate.py\"",
            "statusMessage": "validating provenance claims"
          }
        ]
      }
    ]
  }
}
